[Unit]
Description=PaneFleet dashboard
Documentation=file://@ROOT@/README.md
Wants=network-online.target panefleet-workloads.service
After=network-online.target panefleet-workloads.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=HOST=@HOST@
Environment=PORT=@PORT@
Environment=NODE_ENV=production
Environment=ORCH_CONTROL_PLANE_MODE=systemd-user
Environment=CODEX_HOME=@HOME@/.codex
Environment="ORCHESTRATOR_PLANNING_CODEX_MODE=@PLANNING_CODEX_MODE@"
Environment="ORCHESTRATOR_PLANNING_CODEX_EXECUTABLE=@PLANNING_CODEX_EXECUTABLE@"
Environment="ORCHESTRATOR_PLANNING_CODEX_VERSION=@PLANNING_CODEX_VERSION@"
Environment="ORCHESTRATOR_PLANNING_CODEX_SHA256=@PLANNING_CODEX_SHA256@"
Environment=TMUX=
Environment=TMUX_PANE=
Environment="PATH=@NODE_DIR@:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/usr/sbin"
ExecStart=@NODE@ @ROOT@/server.js
Restart=always
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
LockPersonality=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelTunables=true
RestrictRealtime=true
SystemCallArchitectures=native
SyslogIdentifier=agent-orchestrator

[Install]
WantedBy=default.target
